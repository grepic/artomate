# ============================================================================
# ARTOMATE CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# API Keys
# ----------------------------------------------------------------------------

# OpenAI (DALL-E 3)
OPENAI_API_KEY=sk-...

# Stability AI (optional)
STABILITY_API_KEY=sk-...

# Printify
PRINTIFY_API_TOKEN=your-printify-token
PRINTIFY_SHOP_ID=12345

# Etsy
ETSY_API_KEY=your-etsy-key
ETSY_API_SECRET=your-etsy-secret
ETSY_SHOP_ID=12345678

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# SQLite (default)
DATABASE_URL=sqlite:///data/artomate.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/artomate

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------

# Local filesystem
ASSETS_DIR=./data/assets
EXPORTS_DIR=./exports

# S3 (optional, for production)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=artomate-assets
# AWS_REGION=us-east-1

# ----------------------------------------------------------------------------
# n8n Integration
# ----------------------------------------------------------------------------

N8N_WEBHOOK_URL=http://localhost:5678/webhook/artomate
N8N_API_KEY=your-n8n-api-key

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# Environment
ENV=development  # development, production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/artomate.log

# Image Generation
DEFAULT_IMAGE_PROVIDER=openai  # openai, stability
DEFAULT_IMAGE_SIZE=1024x1024
DEFAULT_IMAGE_QUALITY=hd  # standard, hd (DALL-E only)

# Printify Defaults
DEFAULT_PRINT_PROVIDER_ID=99  # Printful
DEFAULT_BLUEPRINT_IDS=3,6,380  # T-shirt, Poster, Mug

# Pricing
MARKUP_PERCENTAGE=45
MINIMUM_PROFIT=5.00
ROUND_PRICES_TO=0.99  # e.g., $19.99

# SEO
SEO_TITLE_TEMPLATE={theme} | {style} | {niche}
SEO_MAX_TAGS=13  # Etsy limit

# Daily Automation
DAILY_CYCLE_ENABLED=false
DAILY_CYCLE_TIME=03:00
DAILY_CYCLE_COUNT=10  # Products per day
DAILY_CYCLE_NICHES=minimalist,boho,japandi,vintage

# Rate Limiting
OPENAI_RPM=50  # Requests per minute
PRINTIFY_RPM=120
ETSY_RPD=10000  # Requests per day

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

ENABLE_COMPLIANCE_CHECK=true
ENABLE_MOCKUP_GENERATION=false
ENABLE_SOCIAL_MEDIA=false
ENABLE_STOCK_PLATFORMS=false
ENABLE_AB_TESTING=false

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------

# API Authentication (if using FastAPI)
API_SECRET_KEY=your-secret-key-change-this
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# Advanced
# ----------------------------------------------------------------------------

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=5  # seconds
RETRY_BACKOFF=2  # exponential backoff multiplier

# Concurrency
MAX_CONCURRENT_JOBS=5
MAX_CONCURRENT_REQUESTS=10

# Timeouts
IMAGE_GENERATION_TIMEOUT=120  # seconds
PRINTIFY_API_TIMEOUT=30
ETSY_API_TIMEOUT=30
